menuconfig ZMK_BEHAVIOR_PDF
	bool "Enable Persistent Default Layer (PDF) Behavior"
	help
	  Enable the pdf (persistent default layer) behavior which switches layers and persists
	  the active layer to settings, restoring it on boot. This mimics the
	  QMK PDF (Persistent Default Layer) function.

if ZMK_BEHAVIOR_PDF

config ZMK_BEHAVIOR_PDF
	select SETTINGS
	select NVS
endif # ZMK_BEHAVIOR_PDF


menuconfig ZMK_BEHAVIOR_LAYER_INFO
	bool "Enable Layer Info Output Behavior"
	help
	  Enable the layer_info behavior which outputs the current active layer and
	  saved default layer to the connected device (via HID keyboard reports).
	  This allows you to type out the current layer information by pressing a key.

if ZMK_BEHAVIOR_LAYER_INFO

config ZMK_BEHAVIOR_LAYER_INFO
	select HID_DEVICE

endif # ZMK_BEHAVIOR_LAYER_INFO
